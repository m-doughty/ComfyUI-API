# Line endings: LF in the repository and in every working tree.
#
# `text=auto` keeps git's own text-or-binary detection; `eol=lf` then
# checks every text file out with LF on every platform, whatever
# `core.autocrlf` says locally. A Windows checkout — Windows Terminal,
# msys2, GitHub's windows-latest runners, which default to
# core.autocrlf=true — gets the same bytes as a macOS or Linux one, so
# a shell script, a Pod file, a golden snapshot or a fixture never
# grows a trailing \r.
#
# Takes effect from the next `git add`. Files already in the index keep
# the bytes they were committed with until a one-off
# `git add --renormalize .` is committed from any clone.
* text=auto eol=lf

# cmd.exe mis-parses an LF-only batch file, so batch files are the one
# kind of text that must reach the disk as CRLF. They are still stored
# LF in the repository.
*.bat text eol=crlf
*.cmd text eol=crlf

# Never converted, never diffed as text.
