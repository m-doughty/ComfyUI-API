use Test;
use lib 'lib';

# Client tests require a running ComfyUI server
# Set COMFYUI_URL env var to enable
unless %*ENV<COMFYUI_URL> {
	plan :skip-all<Set COMFYUI_URL to run client tests>;
}

use ComfyUI::API::Client;
use ComfyUI::API::Workflow;
use ComfyUI::API::Result;

plan 4;

my Str:D $url = %*ENV<COMFYUI_URL>;
my ComfyUI::API::Client $client .= new(:base-url($url));

subtest 'queue-status returns hash' => {
	plan 2;
	my %status = $client.queue-status;
	ok %status<queue_running>:exists, 'Has queue_running';
	ok %status<queue_pending>:exists, 'Has queue_pending';
};

subtest 'node-info returns hash' => {
	plan 1;
	my %info = $client.node-info;
	ok %info.keys.elems > 0, 'Has node types';
};

subtest 'submit-and-wait generates an image' => {
	plan 4;
	my ComfyUI::API::Workflow $wf = ComfyUI::API::Workflow.from-file(
		't/fixtures/simple-workflow.json'.IO
	);
	my ComfyUI::API::Workflow $rendered = $wf.render(%(
		positive_prompt => 'score_9, score_8_up, a landscape painting of rolling hills at sunset, oil on canvas',
		negative_prompt => 'score_4, score_3, blurry, low quality, watermark',
		model_name      => 'ponyDiffusionV6XL_v6StartWithThisOne.safetensors',
		vae_name        => 'sdxl_vae.safetensors',
	));

	diag "Submitting workflow...";
	my ComfyUI::API::Result $result = $client.submit-and-wait($rendered, :timeout(120e0));
	ok $result.defined, 'Got a result';

	my @filenames = $result.image-filenames;
	ok @filenames.elems > 0, "Generated {@filenames.elems} image(s)";
	diag "  Files: {@filenames.join(', ')}";

	# Download the preview image from temp storage
	my %img = $result.images[0];
	my Buf $image = $client.download(%img<filename>,
		:subfolder(%img<subfolder> // ''),
		:type(%img<type> // 'temp'),
	);
	ok $image.bytes > 1000, "Downloaded image is {$image.bytes} bytes";
	diag "  Image size: {$image.bytes} bytes";

	# Verify it's a valid PNG (starts with PNG magic bytes)
	ok $image[0] == 0x89 && $image[1] == 0x50, 'Downloaded file is a valid PNG';
};

subtest 'submit with custom seed produces result' => {
	plan 2;
	my ComfyUI::API::Workflow $wf = ComfyUI::API::Workflow.from-file(
		't/fixtures/simple-workflow.json'.IO
	);
	my ComfyUI::API::Workflow $rendered = $wf.render(%(
		positive_prompt => 'score_9, a simple geometric pattern, abstract art',
		negative_prompt => 'score_4, blurry',
		model_name      => 'ponyDiffusionV6XL_v6StartWithThisOne.safetensors',
		vae_name        => 'sdxl_vae.safetensors',
	));
	$rendered.set('7', 'seed', 12345);
	$rendered.set('7', 'steps', 15);  # Fewer steps for speed

	my ComfyUI::API::Result $result = $client.submit-and-wait($rendered, :timeout(120e0));
	ok $result.image-filenames.elems > 0, 'Generated image with custom seed';
	ok $result.images[0]<type> eq 'temp', 'Preview image stored in temp';
};
